rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Eine "Küche" ist nur mit ihrem Code erreichbar. Auflisten aller Küchen ist verboten.
    match /rooms/{room} {
      allow get, create: if request.auth != null;
      allow list, update, delete: if false;

      // Jede Person schreibt nur ihre eigenen Swipes, lesen dürfen alle in der Küche.
      match /members/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /dishes/{id} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(room));
      }

      match /wishes/{id} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(room));
      }

      match /shopping/{id} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(room));
      }

      // Rundenzähler für "Neue Runde starten"
      match /meta/{id} {
        allow read, write: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(room));
      }
    }
  }
}
